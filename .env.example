# ---------------------------------------------------------------------------
# TrustToPay configuration
# Copy this file to .env (scripts/setup.mjs does this automatically) and fill
# in ONLY the values you need. Never commit .env to source control.
# ---------------------------------------------------------------------------

NODE_ENV=development
DEMO_MODE=true
PORT=4000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
DATABASE_URL="file:./dev.db"

# --- AI provider (optional). Leave AI_PROVIDER=demo for the deterministic engine.
# Supported values: demo | openai-compatible
AI_PROVIDER=demo
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_ESCALATION_THRESHOLD=0.75

# --- PayPal Sandbox (optional for demo mode).
# Set DEMO_MODE=false and fill these in to make REAL Sandbox API calls.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# --- Security. setup.mjs generates a random value if left blank.
SESSION_SECRET=
DEMO_USERS_ENABLED=true

# --- Server-enforced reward limits, in minor currency units (cents).
REWARD_MIN_MINOR=500
REWARD_MAX_MINOR=10000
